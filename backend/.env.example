# Environment Variables - Backend Example Template

# AI Model API Keys
SARVAM_API_KEY="your_sarvam_api_key_here"
HUGGING_FACE_TOKEN="your_hugging_face_token_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# Copernicus Credentials
COPERNICUS_USERNAME="your_username@example.com"
COPERNICUS_PASSWORD="your_password_here"

# Optimal Ship Route
MOSDAC_OSR_URL="https://mosdac.gov.in/OSR/"

# Open-Meteo APIs (Weather, Waves, and Swell)
OPEN_METEO_MARINE_API="https://marine-api.open-meteo.com/v1/marine"
OPEN_METEO_FORECAST_API="https://api.open-meteo.com/v1/forecast"

# IMD APIs (Cyclone & Warnings)
IMD_PORT_WARNING_API="https://api.imd.gov.in/api/v1/portwarning"
IMD_SEA_BULLETIN_API="https://api.imd.gov.in/api/v1/seabulletin"
IMD_COASTAL_BULLETIN_API="https://api.imd.gov.in/api/v1/coastalbulletin"
IMD_CYCLONE_TRACK_API="https://api.imd.gov.in/api/v1/cyclone_track"
IMD_CYCLONE_WIND_API="https://api.imd.gov.in/api/v1/cyclone_wind"

# Copernicus Dataset IDs
COPERNICUS_CHLOROPHYLL_DATASET_ID="cmems_mod_glo_bgc-pft_anfc_0.25deg_P1D-m"
COPERNICUS_SST_DATASET_ID="METOFFICE-GLO-SST-L4-NRT-OBS-SST-V2"

# Static Data Directories
STATIC_DATA_DIR="./data/"

# Mobile Client URL
CLIENT_URL="http://192.168.1.38:8081"
